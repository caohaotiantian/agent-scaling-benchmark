# Copy to .env (gitignored). Never commit real secrets.

# --- Database (session extract) ---
AIBENCH_DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/opencsitool_db?charset=utf8mb4
# DATABASE_URL=   # optional fallback if AIBENCH_DB_URL unset

# --- OpenAI-compatible API (LLM case gen + openai_compat agent) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# 兜底用：模型 YAML 的 `model` 字段优先，仅当它为空时才用这里的值
OPENAI_MODEL=GLM-5.2

# Optional aliases
# AIBENCH_API_KEY=
# AIBENCH_BASE_URL=
# AIBENCH_MODEL=

# Optional cost estimate (USD per million tokens)
# AIBENCH_USD_PER_MTOK=1.0
# AIBENCH_USD_PER_MTOK_INPUT=0.5
# AIBENCH_USD_PER_MTOK_OUTPUT=1.5

# Retry (HTTP/DB + case-level infra)
# AIBENCH_RETRY_MAX=3
# AIBENCH_RETRY_BACKOFF=1.0
# AIBENCH_RETRY_BACKOFF_MAX=20.0
# AIBENCH_CASE_RETRY=2
