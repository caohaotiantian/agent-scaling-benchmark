# Copy to .env (gitignored). Never commit real secrets.
# aibench: synthetic-secrets — the values here are placeholders showing the shape, not credentials.

# --- Database (session extract) ---
AIBENCH_DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/opencsitool_db?charset=utf8mb4
# DATABASE_URL=   # optional fallback if AIBENCH_DB_URL unset

# --- OpenAI-compatible API (LLM case gen + openai_compat agent) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# 兜底用：模型 YAML 的 `model` 字段优先，仅当它为空时才用这里的值
OPENAI_MODEL=GLM-5.2

# Optional aliases
# AIBENCH_API_KEY=
# AIBENCH_BASE_URL=
# AIBENCH_MODEL=

# Optional cost estimate (USD per million tokens)
# AIBENCH_USD_PER_MTOK=1.0
# AIBENCH_USD_PER_MTOK_INPUT=0.5
# AIBENCH_USD_PER_MTOK_OUTPUT=1.5

# Retry (HTTP/DB + case-level infra)
# AIBENCH_RETRY_MAX=3
# AIBENCH_RETRY_BACKOFF=1.0
# AIBENCH_RETRY_BACKOFF_MAX=20.0
# AIBENCH_CASE_RETRY=2

# Timeouts. Both are read by the code and neither was listed here; `live-smoke.yml` sets the
# first, which is how a variable ends up load-bearing while being undocumented.
# AIBENCH_GENERATE_TIMEOUT=300    # seconds a single generate-cases model call may take
# AIBENCH_REQUEST_TIMEOUT=240     # seconds any other HTTP request may take (this is the default)

# Escape hatch for a platform with no filesystem boundary: opencode's sandbox is `sandbox-exec`,
# which is macOS-only, and a run without it can read the case's own answer key. Setting this
# measures anyway and records `sandboxed: false` in the artifact.
# AIBENCH_CASE_ROOT=            # where generated case sets live; point it at a scratch
#                               # directory to work on an isolated corpus
# AIBENCH_ALLOW_UNSANDBOXED=1
